{
	"folders": [
		{
			"path": "."
		}
	],
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug Rust (MSVC)",
				"type": "cppvsdbg",
				"request": "launch",
				"program": "${workspaceFolder}\\target\\debug\\examples\\basic.exe",
				"args": [],
				"cwd": "${workspaceFolder}",
				"environment": [],
				// "console": "integratedTerminal"
				"console": "externalTerminal"
			}
		]
	},
	"settings": {
    // "workbench.editor.showTabs": "none",


		/////////////////////////////////////////////////
		// "rust-analyzer.checkOnSave": true,
		// "rust-analyzer.procMacro.enable": true,
		// "rust-analyzer.imports.granularity.group": "module",
		// "rust-analyzer.imports.prefix": "crate",
		// /////////////////////////////////////////////////
		// "rust-analyzer.completion.autoimport.enable": true,
		// "rust-analyzer.completion.callable.snippets": "fill_arguments",
		// "rust-analyzer.completion.postfix.enable": true,
		///////////////////////////////////////////////
		// "editor.inlayHints.enabled": "off",
		"editor.codeLens": true,
		// "rust-analyzer.lens.references.enable": false,
		"rust-analyzer.lens.implementations.enable": false,
		"rust-analyzer.lens.run.enable": true,
		"rust-analyzer.lens.debug.enable": true,
		// "rust-analyzer.lens.enumVariantReferences.enable": false,
		"editor.codeActionWidget.showHeaders": false,
		"editor.minimap.enabled": false,
		"terminal.integrated.defaultLocation": "view",
		"workbench.panel.defaultLocation": "right",
		"workbench.panel.showLabels": false,
		"scm.diffDecorations": "all",
		// "terminal.integrated.defaultLocation": "view",
		"rust-analyzer.cargo.extraArgs": [],
		"rust-analyzer.cargo.features": [
			"use_macroquad",
			"use_json",
		],
		//   "rust-analyzer.cargo.noDefaultFeatures": true,
		"rust-analyzer.cargo.cfgs": [
			// "debug_assertions"
		],
		// "not(debug_assertions)",
		"editor.fontSize": 32,
		"editor.mouseWheelZoom": true,
		"workbench.colorTheme": "Default Dark Modern",
		"[rust]": {
			"editor.defaultFormatter": "rust-lang.rust-analyzer",
			"editor.formatOnSave": true,
			"editor.inlayHints.enabled": "offUnlessPressed",
			"editor.semanticHighlighting.enabled": false,
			"editor.mouseWheelZoom": true,
			"editor.wordBasedSuggestions": "off",
			"editor.quickSuggestionsDelay": 200,
		},
		"files.watcherExclude": {},
		"files.exclude": {
			"target": true,
			"Cargo.lock": true,
		},
		"search.exclude": {
			"target": true,
		},
		"jupyter.widgetScriptSources": [
			"jsdelivr.com",
			"unpkg.com"
		],
		"editor.defaultFoldingRangeProvider": null,
		"editor.defaultFormatter": null,
		"todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))\\s*($TAGS)",
		"[json]": {
			"editor.defaultFormatter": "esbenp.prettier-vscode",
			"prettier.trailingComma": "all"
		},
	},
	"tasks": {
		"version": "2.0.0",
		"inputs": [
			{
				"id": "buildMode",
				"type": "pickString",
				"options": [
					"--release",
					""
				],
				"default": "",
				"description": "build mode"
			}
		],
		"tasks": [
			{
				"label": "build",
				"type": "shell",
				"linux": {
					"command": "cargo build  --examples --features use_json --features use_macroquad"
				},
				"windows": {
					"command": "cargo build --examples  --features use_json --features use_macroquad"
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#8db9d3",
						"label": "build"
					}
				},
				"presentation": {
					"clear": true
				}
			},
			{
				"label": "run",
				"type": "shell",
				"linux": {
					"command": "cargo run --example json_hot_reloading --features use_json --features use_macroquad"
				},
				"windows": {
					"command": "cargo run --example json_hot_reloading --features use_json --features use_macroquad"
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#8db9d3",
						"label": "run"
					}
				},
				"presentation": {
					"clear": true
				}
			},
			{
				"label": "run +",
				"type": "shell",
				"linux": {
					"command": "RUST_BACKTRACE='full' cargo run  --features use_json --features use_macroquad"
				},
				"windows": {
					"command": "$env:RUST_BACKTRACE='full';cargo run  --features use_json --features use_macroquad"
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#8db9d3",
						"label": "run +"
					}
				},
				"presentation": {
					"clear": true
				}
			},
			{
				"label": "test",
				"type": "shell",
				"linux": {
					"command": "python3 ${workspaceFolder}/.vscode/launch_test.py 1  ${workspaceFolder}",
				},
				"windows": {
					"command": "python ${workspaceFolder}/.vscode/launch_test.py 1  ${workspaceFolder}",
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#06e25b",
						"label": "$(runtime-extensions-editor-label-icon) test"
					},
				},
				"presentation": {
					"clear": true
				}
			},
			{
				"label": "check",
				"type": "shell",
				"linux": {
					"command": "cargo check ${input:buildMode} --target-dir target/_check2 --features use_json --features use_macroquad"
				},
				"windows": {
					"command": "cargo check ${input:buildMode} --target-dir target/_check2 --features use_json --features use_macroquad"
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#8db9d3",
						"label": "$(runtime-extensions-editor-label-icon) check",
						"detail": "tooltip for <b>statusbar</b>"
					}
				},
				"presentation": {
					"clear": true
				}
			},
			{
				"label": "clippy",
				"type": "shell",
				"linux": {
					"command": "cargo clippy  ${input:buildMode} --features use_json --features use_macroquad"
				},
				"windows": {
					"command": "cargo clippy  ${input:buildMode} --features use_json --features use_macroquad"
				},
				"args": [],
				"group": "build",
				"problemMatcher": [],
				"options": {
					"cwd": "${workspaceFolder}",
					"statusbar": {
						"color": "#b2d38d",
						"label": "clippy"
					}
				},
				"presentation": {
					"clear": true
				}
			},
		]
	}
}